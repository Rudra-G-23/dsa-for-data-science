---
import BaseLayout from '../layouts/BaseLayout.astro';
import AskTools from '../components/AskTools.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';
import { renderMarkdown } from '../lib/renderMarkdown';
import explainSource from '../../skills/dsa-explain/SKILL.md?raw';
import traceSource from '../../skills/dsa-trace/SKILL.md?raw';
import coachSource from '../../skills/dsa-coach/SKILL.md?raw';
const skills = [
  ['dsa-explain', 'Explain one topic', explainSource],
  ['dsa-trace', 'Trace before code', traceSource],
  ['dsa-coach', 'Coach one hint at a time', coachSource],
];
---
<BaseLayout title={`Study skills - ${site.title}`} description="Reusable Markdown instruction packages for AI-assisted DSA study." image="/social/og-reference.svg">
  <section class="reference-hero"><a class="back-link" href={`${site.basePath}/`}>← Back home</a><SectionLabel>Reusable instructions</SectionLabel><h1>Make AI a better<br /><em>study partner.</em></h1><p>These small, versioned Markdown packages give your preferred AI tool a clear role: explain, trace, or coach.</p><AskTools stageTitle="Reusable DSA study skills" /></section>
  <section class="skill-layout"><nav class="skill-sidebar" aria-label="Skills table of contents"><div class="sidebar-title"><Icon name="book" size={17} /><strong>Skills</strong></div>{skills.map(([name, title]) => <a href={`#${name}`}>{title}</a>)}</nav><div class="skill-grid">{skills.map(([name, title, source]) => <article class="skill-card" id={name}><span class="card-number">SKILL</span><h2>{title}</h2><div class="skill-content"><Fragment set:html={renderMarkdown(source as string)} /></div><code>/{name}</code><a class="text-link" href={`${site.repository}/tree/main/skills/${name}`} target="_blank" rel="noreferrer">Open package on GitHub <Icon name="external" size={14} /></a></article>)}</div></section>
  <section class="source-link-panel"><SectionLabel>How to use them</SectionLabel><h2>Copy or link a skill folder into the skills directory supported by your AI tool.</h2><p class="section-description">The repository README records the package layout and invocation names. Each package includes a version and a short response contract.</p><a class="text-link" href={`${site.repository}/blob/main/skills/README.md`} target="_blank" rel="noreferrer">Read the skills README <span>↗</span></a></section>
</BaseLayout>
