---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/SectionLabel.astro';
import StageCard from '../components/StageCard.astro';
import StageGrid from '../components/StageGrid.astro';
import ProgressPanel from '../components/ProgressPanel.astro';
import { stages } from '../data/stages';
import { referencePages, site } from '../data/site';
---
<BaseLayout title={site.title} description={site.description} image="/social/og-home.svg">
  <section class="hero section-grid">
    <div class="hero-copy"><SectionLabel>A calmer way to learn the fundamentals</SectionLabel><h1>Learn to think<br /><em>in structures.</em></h1><p class="hero-intro">A practical, Python-first path through data structures and algorithms - built for data science, machine learning, and the curious beginner.</p><div class="hero-actions"><a class="button button-primary" href="#roadmap">Start the roadmap <span>→</span></a><button class="button button-quiet" data-open-setup>Find my starting point <span>↗</span></button></div><p class="hero-note"><span class="checkmark">✓</span> No account. No streaks. Your progress stays in your browser.</p></div>
    <div class="hero-visual" aria-label="A visual showing a learning path from Python to machine learning"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="path-label label-python"><span class="node node-coral"></span> Python</div><div class="path-label label-structures"><span class="node node-blue"></span> Structures</div><div class="path-label label-algorithms"><span class="node node-yellow"></span> Algorithms</div><div class="path-label label-ml"><span class="node node-white"></span> ML thinking</div><div class="path-arrow arrow-one">↗</div><div class="path-arrow arrow-two">↘</div><div class="hero-visual-caption"><span>01</span><span>build the mental model</span></div></div>
  </section>
  <section class="stats-strip" aria-label="Roadmap facts"><div><strong>19</strong><span>learning stages</span></div><div><strong>5</strong><span>passes per topic</span></div><div><strong>100%</strong><span>open source</span></div><div class="stats-message">The goal is not to memorize patterns.<br /><b>It is to recognize why they work.</b></div></section>
  <section class="roadmap-section" id="roadmap"><div class="section-heading"><div><SectionLabel>The guided path</SectionLabel><h2>Start small.<br /><em>Go deep.</em></h2></div><p class="section-description">A dependency-safe sequence that takes you from Python foundations to the structures and patterns that show up in real data work.</p></div><div class="current-card" data-current-card><div class="current-card-top"><span class="mono-label">YOUR NEXT STEP</span><span data-current-status>STAGE 00 / 19</span></div><div class="current-card-body"><div class="stage-number" data-current-number>00</div><div class="stage-info"><p class="eyebrow" data-current-eyebrow>Python foundations</p><h3 data-current-title>Get comfortable with the objects underneath the code.</h3><p data-current-description>Values, variables, mutability, copying, memory, and the small Python toolkit you will use in every stage after this.</p></div><a class="button button-dark" data-current-link href="/dsa-for-data-science/stage/python-foundations/">Open stage <span>→</span></a></div><div class="progress-track"><span data-current-progress></span></div></div><div class="stage-grid stage-grid-featured">{stages.slice(1, 5).map((stage) => <StageCard stage={stage} compact />)}</div><div class="roadmap-toolbar"><div><SectionLabel>Complete sequence</SectionLabel><h3>Choose a stage</h3></div><label class="search-field"><span>⌕</span><input data-stage-search type="search" placeholder="Search stages" /></label></div><StageGrid /><a class="text-link" href="/dsa-for-data-science/roadmap/">See the complete roadmap <span>→</span></a></section>
  <section class="practice-section section-grid" id="practice"><div class="practice-visual"><div class="practice-page"><span class="page-kicker">TODAY'S PRACTICE</span><h3>Trace before<br /><em>you run.</em></h3><div class="trace-lines"><span></span><span></span><span></span><span></span></div><div class="page-footer"><span>paper first</span><span>04 / 19</span></div></div><div class="floating-note">predict<br /><span>→</span> run<br /><span>→</span> explain</div></div><div class="practice-copy"><SectionLabel>The practice loop</SectionLabel><h2>Understand it.<br /><em>Then make it yours.</em></h2><p>Every stage follows the same reliable rhythm: build the mental model, draw the state, implement the core operation, use the Pythonic version, then solve a few problems.</p><div class="loop-list"><div><span>01</span><b>Understand</b><small>what it is and why it exists</small></div><div><span>02</span><b>Trace</b><small>the state on paper before code</small></div><div><span>03</span><b>Implement</b><small>the operation yourself</small></div><div><span>04</span><b>Apply</b><small>recognize it in a new problem</small></div></div></div></section>
  <section class="reference-section" id="references"><div class="section-heading"><div><SectionLabel>Keep nearby</SectionLabel><h2>One home for<br /><em>the whole system.</em></h2></div><p class="section-description">The guided path is the front door. These reference pages keep the original roadmap, practice system, prompts, and vocabulary available when you need them.</p></div><div class="reference-grid">{referencePages.map((page) => <a class:list={['reference-card', `reference-card-${page.tone}`]} href={`${site.basePath}${page.href}`}><span class="resource-type">{page.eyebrow}</span><h3>{page.title}</h3><p>{page.description}</p><span class="resource-link">Open page <b>↗</b></span></a>)}</div></section>
  <ProgressPanel />
  <section class="closing-section"><SectionLabel>One idea at a time</SectionLabel><h2>You do not need to<br /><em>be good at DSA yet.</em></h2><p>Just start with the next honest question.</p><a class="button button-primary" href="#roadmap">Take the next step <span>→</span></a></section>
  <dialog class="setup-dialog" data-setup-dialog><button class="dialog-close" data-close-setup aria-label="Close setup">×</button><SectionLabel>Find your starting point</SectionLabel><h2>Where are you<br /><em>right now?</em></h2><p class="dialog-copy">This is guidance, not a test. Pick the answer that feels most like you.</p><div class="setup-options"><button data-level="new">I am new to coding <span>→</span></button><button data-level="python">I know Python basics <span>→</span></button><button data-level="dsa">I can code, but DSA is new <span>→</span></button><button data-level="some">I know some DSA <span>→</span></button></div><p class="dialog-note" data-setup-note></p></dialog>
</BaseLayout>
