---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AskTools from '../../components/AskTools.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import { stages } from '../../data/stages';
import { site } from '../../data/site';

export function getStaticPaths() {
  return stages.map((stage) => ({ params: { slug: stage.slug }, props: { stage } }));
}

const { stage } = Astro.props;
const publicUrl = `${site.basePath}/stage/${stage.slug}/`;
const nextStage = stages[Number(stage.id) + 1];
const previousStage = stages[Number(stage.id) - 1];
---
<BaseLayout title={`${stage.title} - ${site.title}`} description={stage.description} image="/social/og-stage.svg">
  <article class="stage-page" data-stage-page data-stage-id={stage.id} data-stage-title={stage.title} data-stage-description={stage.description} data-page-url={publicUrl}>
    <header class="stage-hero"><a class="back-link" href={`${site.basePath}/#roadmap`}>← Back to roadmap</a><div class="stage-hero-meta"><SectionLabel>Stage {stage.id} / {stages.length - 1}</SectionLabel><span class:list={['priority-pill', `priority-${stage.accent}`]}>Python-first</span></div><h1>{stage.title}</h1><p class="stage-lede">{stage.description}</p><AskTools stageId={stage.id} stageTitle={stage.title} pageUrl={publicUrl} /></header>
    <div class="stage-layout"><main class="stage-main"><section class="stage-intro-card"><span class="mono-label">THE AIM</span><h2>{stage.aim}</h2><button class="complete-button" data-stage-complete data-stage-id={stage.id}><span data-complete-label>Mark stage complete</span><span aria-hidden="true">✓</span></button></section><section class="topic-section"><SectionLabel>Use this stage in five passes</SectionLabel><div class="passes-grid"><div><b>01</b><strong>Understand</strong><p>What is the object, and what problem does it solve?</p></div><div><b>02</b><strong>Trace</strong><p>Draw the state or memory before you write the code.</p></div><div><b>03</b><strong>Implement</strong><p>Build the core operation yourself once.</p></div><div><b>04</b><strong>Use Python</strong><p>Compare your implementation with the library version.</p></div><div><b>05</b><strong>Apply</strong><p>Solve a few problems until the pattern is recognizable.</p></div></div></section><section class="topic-section practice-callout"><SectionLabel>Start with one honest session</SectionLabel><h2>{stage.practice}</h2><p>Keep the session small enough to finish. The practice companion has the detailed worksheet, stage-specific activities, and prompts.</p><a class="text-link" href={`${site.basePath}/practice/`}>Open the full practice companion <span>→</span></a></section></main><aside class="stage-aside"><div class="resource-stack"><span class="resource-type">PRIMARY RESOURCE</span><a href={stage.primary.href} target="_blank" rel="noreferrer"><strong>{stage.primary.label}</strong><span>Open resource ↗</span></a><span class="resource-type">VISUAL OR PRACTICE</span><a href={stage.visual.href} target="_blank" rel="noreferrer"><strong>{stage.visual.label}</strong><span>Open resource ↗</span></a><a class="directory-link" href={`${site.basePath}/resources/`}>Full resource directory <span>→</span></a></div><div class="stage-note"><span class="resource-type">KEEP THE RULE VISIBLE</span><p>Write one sentence that stays true after every operation. That sentence is more useful than a page of copied code.</p></div></aside></div>
    <nav class="stage-pagination" aria-label="Stage navigation">{previousStage ? <a href={`${site.basePath}/stage/${previousStage.slug}/`}>← {previousStage.title}</a> : <span></span>}{nextStage ? <a href={`${site.basePath}/stage/${nextStage.slug}/`}>{nextStage.title} →</a> : <a href={`${site.basePath}/#workspace`}>Finish the path →</a>}</nav>
  </article>
</BaseLayout>
