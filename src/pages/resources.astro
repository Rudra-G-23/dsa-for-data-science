---
import BaseLayout from '../layouts/BaseLayout.astro';
import AskTools from '../components/AskTools.astro';
import SectionLabel from '../components/SectionLabel.astro';
import { renderMarkdown } from '../lib/renderMarkdown';
import metadataSource from '../../docs/resources-meta-data.md?raw';
import { site } from '../data/site';
import { stages } from '../data/stages';
const html = renderMarkdown(metadataSource);
---
<BaseLayout title={`Resource directory - ${site.title}`} description="A dependency-safe directory of free DSA, Python, NumPy, SciPy, visualization, and practice resources." image="/social/og-reference.svg">
  <section class="reference-hero"><a class="back-link" href={`${site.basePath}/`}>← Back home</a><SectionLabel>Resource directory</SectionLabel><h1>Good resources<br /><em>at the right time.</em></h1><p>Every stage has a primary explanation, a visual or practice companion, and a path to go deeper when you are ready.</p><AskTools stageTitle="DSA resource directory" /></section>
  <section class="resource-directory"><div class="directory-intro"><SectionLabel>Stage by stage</SectionLabel><h2>Start with<br /><em>one link.</em></h2><p>Choose the stage you are on, then use the two links as a small default set. The full source directory remains below.</p></div><div class="directory-list">{stages.map((stage) => <article><div class="directory-stage"><span>{stage.id}</span><strong>{stage.title}</strong></div><a href={stage.primary.href} target="_blank" rel="noreferrer"><small>PRIMARY</small>{stage.primary.label} ↗</a><a href={stage.visual.href} target="_blank" rel="noreferrer"><small>VISUAL / PRACTICE</small>{stage.visual.label} ↗</a></article>)}</div></section>
  <article class="source-content"><div class="source-content-head"><SectionLabel>How the collection is curated</SectionLabel><p>Last updated: 2026-09-18</p><p>Rendered from <a href={`${site.repository}/blob/main/docs/resources-meta-data.md`} target="_blank" rel="noreferrer">docs/resources-meta-data.md ↗</a></p></div><Fragment set:html={html} /></article>
</BaseLayout>
