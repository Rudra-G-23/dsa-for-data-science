---
import type { Stage } from '../data/stages';
import Icon from './Icon.astro';
const { stage, compact = false } = Astro.props as { stage: Stage; compact?: boolean };
---
<a class:list={['stage-card', `stage-card-${stage.accent}`, compact && 'stage-card-compact']} data-stage-card data-stage-id={stage.id} data-stage-title={stage.title} data-stage-description={stage.description} data-stage-slug={stage.slug} href={`/dsa-for-data-science/stage/${stage.slug}/`}>
  <span class="card-number">{stage.id}</span>
  <span class="stage-card-copy"><strong>{stage.title}</strong><small>{stage.description}</small></span>
  <Icon name="arrow" size={18} />
</a>
